//2D array concept arr[i][j] here ex [[1,2,3],[5,6,7]]
//there is 2 1d array in this 2d array
//representation arr[0]=[1,2,3] and arr[1]=[5.6.7]
//accounts[][]
class Solution {
   
    public int maximumWealth(int[][] accounts) {
        int[] sum = new int[accounts.length]; //int sum[]; or int sum[]=0 it is not initialize
        int num=0;
        for(int i=0;i<=accounts.length-1;i++){
            for(int j=0;j<=accounts[i].length-1;j++){
                sum[i]=sum[i]+accounts[i][j];
            }
        }for(int i=0;i<=sum.length-1;i++){
        //    if(sum[i]>=sum[i+1]){
        //     num=sum[i];
        //dont adopt this pattern
        //correct is
        // if(sum[i]>num){
        //     num=sum[i];
        
        //    }
        num=Math.max(num,sum[i]);
        }return num;
    }
}
